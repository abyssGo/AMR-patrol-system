<?xml version="1.0"?>
<package format="3">
  <name>patrol_amr_safety</name>
  <version>0.1.0</version>
  <description>
    AMR PC nodes: mission_supervisor (Patrol Action Server), local_safety_supervisor
    (final drive-output gate: DriveToken, EStop, cmd_vel arbitration) and the
    detection/alignment node (DetectEvent server, ReportDetection client).
  </description>

  <maintainer email="kj270477@gmail.com">조정묵</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>turtlebot4_navigation</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <!-- ultralytics(YOLO)는 rosdep 키가 없어 pip로 설치한다: pip install ultralytics -->
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>patrol_interfaces</exec_depend>
  <exec_depend>patrol_amr_interfaces</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>irobot_create_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
